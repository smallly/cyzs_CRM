{
  "name": "crm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:saas",
    "dev:saas": "vite --mode saas --host 0.0.0.0 --port 5173",
    "dev:vendor": "vite --mode vendor --host 0.0.0.0 --port 5174",
    "build": "npm run build:saas",
    "build:saas": "vue-tsc -b && vite build --mode saas",
    "build:vendor": "vue-tsc -b && vite build --mode vendor",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0"
  }
}
